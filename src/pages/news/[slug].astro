---
import { marked } from "marked";
import type { GetStaticPaths } from "astro";
import { getPosts } from "@lib/get-post";

import MainLayout from "@/layouts/MainLayout.astro";
import Date from "@/components/News/Date.astro";
import Category from "@components/News/Category.astro";

export const getStaticPaths = (async () => {
  const posts = await getPosts();

  return posts.map((reportage) => ({
    params: {
      slug: reportage.slug,
    },
    props: { reportage },
  }));
}) satisfies GetStaticPaths;

const { reportage } = Astro.props;
const { slug, title, cover, date, category, gallery, description } = reportage;
export const prerender = true;
---

<MainLayout title={title}>
  <h1 transition:name={`title-${slug}`} class="mb-3 text-center text-4xl">
    {title}
  </h1>
  <hr class="my-4" />
  <img class="mx-auto mb-5" src={cover.url} alt={`Fotográfia - ${title}`} />

  <section class="mx-auto flex max-w-4xl flex-col gap-3 bg-gray-200 p-6">
    <h4>Imágenes para descargar</h4>

    <div class="flex gap-12 overflow-x-auto">
      {
        gallery.map(({ url }) => (
          <img
            class="w-72 object-cover"
            src={url}
            alt={`Fotográfia - ${title}`}
          />
        ))
      }
    </div>
  </section>

  <section class="mx-auto my-4 max-w-5xl">
    <div class="mb-4 flex items-center justify-between">
      <Date date={date} />
      <Category name={category.title} />
    </div>
    <div
      class="prose max-w-full text-justify text-sm text-black"
      set:html={marked.parse(description)}
    />
  </section>
</MainLayout>
