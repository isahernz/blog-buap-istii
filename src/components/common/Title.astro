<h3 class="mb-4 text-xl font-semibold">
  Noticias Anteriores
  <span id="ip" class="text-sm font-normal text-gray-500"></span>
</h3>

<script>
  import { IP_API_ENDPOINT } from "astro:env/client";

  const response = await fetch(IP_API_ENDPOINT);
  const ip = await response.text();

  const span = document.getElementById("ip") as HTMLSpanElement;
  span.innerText = `Tu IP es: ${ip}`;
</script>
