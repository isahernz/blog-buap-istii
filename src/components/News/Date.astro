---
import dayjs from "dayjs";
import "dayjs/locale/es";

dayjs.locale("es");

interface Props {
  date: string;
}

const { date } = Astro.props;
const dateFormatted = dayjs(date).locale("es").format("dddd, MMMM DD, YYYY");
---

<span class="flex items-center gap-1 text-xs capitalize text-gray-500">
  {dateFormatted}
</span>
