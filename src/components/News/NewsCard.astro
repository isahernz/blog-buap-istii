---
import { marked } from "marked";
import Category from "./Category.astro";

interface PostCardProps {
  title: string;
  image: string;
  date: string;
  category: string;
  url: string;
  description: string;
}

const { title, image, date, category, url, description } =
  Astro.props as PostCardProps;
---

<article class="max-w-4xl bg-gray-200 p-6">
  <header class="flex items-center justify-between">
    <a href={`news/${url}`} class="hover:underline hover:underline-offset-2">
      <h2 class="text-xl font-bold leading-tight text-navy-blue">
        {title}
      </h2>
    </a>
  </header>

  <div class="mt-4 flex flex-col gap-4 md:flex-row">
    <div class="relative h-full flex-shrink-0">
      <img src={image} class="w-full object-cover md:w-80" alt="" />
      <Category class="absolute bottom-0 right-0" name={category} />
    </div>
    <div
      class="py-4 text-sm"
      set:html={marked.parse(
        description.slice(0, description.indexOf(".", 100) + 1)
      )}
    />
  </div>
</article>
